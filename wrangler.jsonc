{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tippen",
  "compatibility_date": "2026-07-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".gitignore",
      ".wrangler/**",
      "README.md",
      "LICENSE"
    ]
  },
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
